#!/bin/sh
# postinstall — hand the machine over to the version that was just installed:
# set up the per-user LaunchAgent so the dispatchq daemon starts at login, make
# sure the *new* daemon is the one actually running, and reopen the app.
#
# The installer runs as root, but the LaunchAgent belongs to the logged-in user,
# so we drop into that user's GUI launchd context to install it. The bundled
# daemon's own `install` command writes ~/Library/LaunchAgents and bootstraps
# gui/<uid>, pointing the plist at the daemon inside the app bundle.
#
# The hand-over is verified, not assumed. The dashboard reports the version of
# the *running daemon*, so an old daemon that survives the install leaves the
# user on the old version with the update prompt still up — an install that
# looks successful and changed nothing. If the takeover cannot be completed,
# this script fails the install rather than reporting success.
set -e
# Installer helpers must use Apple's utilities, even if the invoking shell
# exports a PATH containing GNU stat or other incompatible replacements.
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

APP="/Applications/DispatchQ.app"
DAEMON="$APP/Contents/MacOS/dispatchqd"
LABEL="de.maierdaniel.dispatchq"
PORT=10765
# The app was called ClaudeQ before 2.0. An update from there finds its app,
# LaunchAgent, wake permission and receipt under these names; they are retired
# once DispatchQ runs: `dispatchqd install` boots out ClaudeQ's agent and stops
# its daemon before it moves the data directory (internal/store/rename.go), and
# retire_claudeq clears away the rest.
LEGACY_LABEL="de.maierdaniel.claudeq"
LEGACY_APP="/Applications/ClaudeQ.app"
# The port ClaudeQ used before 10765. An old daemon still listens there, and
# with the dashboard moved it no longer collides with the new one — so nothing
# would stop the two from running the queue side by side. The takeover sweeps
# both ports; this line can go once no install older than the switch is left.
LEGACY_PORT=8765

if [ ! -x "$DAEMON" ]; then
	echo "dispatchq: FAILED: daemon not found at $DAEMON"
	exit 1
fi

# link_claudeq_cli makes ClaudeQ.app a link to DispatchQ.app, so a script that
# still calls /Applications/ClaudeQ.app/Contents/MacOS/claudeq reaches the new
# CLI (the bundle carries a claudeq link to dispatchq, see scripts/build-app.sh).
# The old path is deprecated, not gone; a later release drops the link. It is
# made only where nothing is: a real ClaudeQ.app waits for retire_claudeq.
link_claudeq_cli() {
	if [ -L "$LEGACY_APP" ]; then
		if [ ! "$LEGACY_APP" -ef "$APP" ]; then
			echo "dispatchq: FAILED: $LEGACY_APP links somewhere other than $APP"
			return 1
		fi
		return 0
	fi
	if [ ! -e "$LEGACY_APP" ] && [ ! -L "$LEGACY_APP" ]; then
		if ! ln -s "$(basename "$APP")" "$LEGACY_APP"; then
			echo "dispatchq: FAILED: cannot create compatibility link $LEGACY_APP"
			return 1
		fi
		echo "dispatchq: linked $LEGACY_APP to $APP for old scripts"
	fi
	return 0
}
link_claudeq_cli

# /dev/console alone can report root in the installer context even while a
# user's GUI and old daemon are running. Ask SystemConfiguration first, then
# fall back to the console device and login records. Accept only a real GUI
# domain; never install an agent for root or the login window.
candidates=$(
	printf 'show State:/Users/ConsoleUser\n' | scutil 2>/dev/null |
		sed -n 's/^[[:space:]]*Name[[:space:]]*:[[:space:]]*//p'
	stat -f "%Su" /dev/console 2>/dev/null || true
	who 2>/dev/null | awk '$2 == "console" { print $1 }'
)
consoleUser=""
uid=""
for candidate in $candidates; do
	case "$candidate" in root|loginwindow|_mbsetupuser) continue ;; esac
	candidateUID=$(id -u "$candidate" 2>/dev/null || true)
	case "$candidateUID" in ""|0|*[!0-9]*) continue ;; esac
	if launchctl print "gui/$candidateUID" >/dev/null 2>&1; then
		consoleUser="$candidate"
		uid="$candidateUID"
		break
	fi
done
if [ -z "$consoleUser" ]; then
	# A live daemon proves that silently skipping the hand-over is unsafe.
	# Fail visibly instead of claiming success with the old version still up.
	if pgrep -x claudeqd >/dev/null 2>&1 || pgrep -x dispatchqd >/dev/null 2>&1; then
		echo "dispatchq: FAILED: cannot resolve GUI user while a ClaudeQ or DispatchQ daemon is running"
		exit 1
	fi
	# Headless / no GUI login window user — the app will set up autostart on its
	# first launch instead. Don't fail the install over it.
	echo "dispatchq: no console user; the app will set up autostart on first launch"
	exit 0
fi
echo "dispatchq: handing over ClaudeQ and DispatchQ services for $consoleUser (uid $uid)"
# The LaunchAgent plist lives in the console user's home. Resolve it defensively:
# an empty home would make "$homeDir/Library/..." point at the *system*
# LaunchAgents directory, which this script must never touch.
homeDir=$(dscl . -read "/Users/$consoleUser" NFSHomeDirectory 2>/dev/null | sed -n 's/^NFSHomeDirectory: //p')
plist=""
if [ -n "$homeDir" ] && [ -d "$homeDir" ]; then
	plist="$homeDir/Library/LaunchAgents/$LABEL.plist"
fi

# The version this package just put in /Applications. The running daemon must
# report exactly this once the takeover is done.
want=$("$DAEMON" --version 2>/dev/null | tr -d ' \t\n' | sed 's/^v//' || true)
if [ -z "$want" ]; then
	echo "dispatchq: FAILED: installed daemon cannot report its version"
	exit 1
fi
echo "dispatchq: installed version ${want:-unknown}"

# asuser runs a command in the console user's GUI launchd domain; sudo -u adopts
# their identity and HOME so launchctl and the plist land in the right place.
as_user() {
	launchctl asuser "$uid" sudo -H -u "$consoleUser" "$@"
}

# running_version echoes the version the live daemon reports, "" if nothing
# answers on the loopback port.
running_version() {
	curl -sf --max-time 1 "http://127.0.0.1:$PORT/api/update" 2>/dev/null |
		sed -n 's/.*"current":"\([^"]*\)".*/\1/p'
}

# stop_daemons targets only the console user, by exact executable name and
# listening port. This also catches an old daemon started without a run argument,
# without matching editors or command lines that merely mention the binary.
stop_daemons() {
	sig="$1"
	for name in dispatchqd claudeqd; do
		pkill "$sig" -u "$uid" -x "$name" 2>/dev/null || true
	done
	# -a ANDs the name against the ports (lsof ORs the -c and the -i filters
	# among themselves): only a *dispatchqd* or *claudeqd* that listens on one
	# of our ports. An unrelated process holding one is not ours to kill.
	holders=$(lsof -ti -a -u "$uid" -c dispatchqd -c claudeqd -sTCP:LISTEN -i "tcp:$PORT" -i "tcp:$LEGACY_PORT" 2>/dev/null || true)
	if [ -n "$holders" ]; then
		# shellcheck disable=SC2086 # deliberate word splitting: one pid per line
		kill $sig $holders 2>/dev/null || true
	fi
	# Give launchd and the OS a moment to reap the processes and free the port.
	sleep 1
}

# retire_claudeq clears away what is left of ClaudeQ once DispatchQ runs: its
# wake permission (DispatchQ installs its own below), its installer receipt,
# and the app. Nothing under /Applications is ever deleted here (see the guard
# in scripts/acceptance.sh): the old app goes to the user's Bin, and only a
# bundle that says it is ClaudeQ.
# In its place goes the link_claudeq_cli link.
retire_claudeq() {
	if [ -e "$LEGACY_APP" ] && [ ! -L "$LEGACY_APP" ]; then
		if [ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$LEGACY_APP/Contents/Info.plist" 2>/dev/null)" != "$LEGACY_LABEL" ]; then
			echo "dispatchq: FAILED: refusing to replace $LEGACY_APP because it is not a ClaudeQ bundle"
			return 1
		fi
		if [ -z "$homeDir" ] || ! as_user mkdir -p "$homeDir/.Trash"; then
			echo "dispatchq: FAILED: cannot prepare the user's Bin for ClaudeQ"
			return 1
		fi
		dest="$homeDir/.Trash/ClaudeQ.app"
		n=0
		while [ -e "$dest" ] || [ -L "$dest" ]; do
			n=$((n + 1))
			dest="$homeDir/.Trash/ClaudeQ $n.app"
		done
		if ! mv "$LEGACY_APP" "$dest"; then
			echo "dispatchq: FAILED: cannot move $LEGACY_APP to the Bin"
			return 1
		fi
		chown -R "$consoleUser" "$dest" 2>/dev/null || true
		echo "dispatchq: moved $LEGACY_APP to the Bin"
	fi
	link_claudeq_cli || return 1
	if [ ! "$LEGACY_APP" -ef "$APP" ] ||
		[ ! "$APP/Contents/MacOS/claudeq" -ef "$APP/Contents/MacOS/dispatchq" ]; then
		echo "dispatchq: FAILED: ClaudeQ compatibility links do not resolve to DispatchQ"
		return 1
	fi
	if [ -f /etc/sudoers.d/claudeq ]; then
		rm -f /etc/sudoers.d/claudeq
		echo "dispatchq: removed ClaudeQ wake permission"
	fi
	pkgutil --forget "$LEGACY_LABEL" >/dev/null 2>&1 && echo "dispatchq: forgot ClaudeQ installer receipt" || true
}

# takeover points the LaunchAgent at the freshly installed daemon and starts it.
takeover() {
	# Stop KeepAlive before killing processes. Otherwise launchd can revive an
	# old binary between the kill and the new daemon's bootstrap. Do this for
	# both names, including on retry, and repair root-owned stale plist files.
	for label in "$LEGACY_LABEL" "$LABEL"; do
		as_user launchctl bootout "gui/$uid/$label" 2>/dev/null || true
		if [ -n "$homeDir" ] && [ -d "$homeDir" ]; then
			rm -f "$homeDir/Library/LaunchAgents/$label.plist" || return 1
		fi
	done
	stop_daemons "-TERM"
	stop_daemons "-KILL"
	if ! as_user "$DAEMON" install; then
		echo "dispatchq: launchctl hand-over failed"
		return 1
	fi
	return 0
}

# settled waits until the running daemon reports the version we installed.
# Bounded by wall time, not by a number of attempts: a port held by something
# that accepts connections but never answers would otherwise stretch each
# attempt to the curl timeout and stall the installer for minutes.
settled() {
	deadline=$(($(date +%s) + 20))
	while [ "$(date +%s)" -lt "$deadline" ]; do
		if [ "$(running_version)" = "$want" ] && ! pgrep -u "$uid" -x claudeqd >/dev/null 2>&1; then
			return 0
		fi
		sleep 0.2
	done
	return 1
}

handed_over=false
if takeover; then handed_over=true; fi

if [ "$handed_over" != true ] || ! settled; then
	echo "dispatchq: the running daemon is still $(running_version), not $want — retrying"
	# Repeat the complete hand-over, including both launchd labels.
	handed_over=false
	if takeover; then handed_over=true; fi
fi

if [ "$handed_over" != true ] || ! settled; then
	echo "dispatchq: FAILED to start DispatchQ $want — the machine is still running $(running_version)"
	echo "dispatchq: LaunchAgent plist: ${plist:-<unknown home>}"
	[ -n "$plist" ] && grep -A1 'ProgramArguments' "$plist" 2>/dev/null || true
	echo "dispatchq: port $PORT is held by:"
	lsof -i "tcp:$PORT" -i "tcp:$LEGACY_PORT" -sTCP:LISTEN 2>/dev/null || true
	echo "dispatchq: DispatchQ.app copies on this machine:"
	as_user mdfind "kMDItemCFBundleIdentifier == '$LABEL'" 2>/dev/null || true
	exit 1
fi

retire_claudeq

# Warn about other copies of the app even on success: whichever one the user
# opens, the dashboard talks to the daemon installed here — but a second copy
# is what makes a future update look like it did nothing.
others=$(as_user mdfind "kMDItemCFBundleIdentifier == '$LABEL'" 2>/dev/null | grep -v "^$APP$" || true)
if [ -n "$others" ]; then
	echo "dispatchq: other DispatchQ.app copies found (delete them to avoid confusion):"
	echo "$others"
fi

# Allow the daemon to schedule wake-ups (pmset) without a password, so timed
# tasks can wake the Mac from sleep. The console user is detected here (not
# hardcoded); the entry is validated with visudo before install so a bad file
# can never break sudo. The uninstaller (Uninstall DispatchQ.pkg) removes it.
sudoers="/etc/sudoers.d/dispatchq"
tmp="$(mktemp)"
printf '%s ALL=(root) NOPASSWD: /usr/bin/pmset\n' "$consoleUser" > "$tmp"
if visudo -cf "$tmp" >/dev/null 2>&1; then
	install -m 0440 -o root -g wheel "$tmp" "$sudoers"
	echo "dispatchq: installed pmset wake permission for $consoleUser"
else
	echo "dispatchq: could not install pmset sudoers entry; scheduled wake will need manual setup"
fi
rm -f "$tmp"

# Reopen DispatchQ for the user (preinstall closed the old window) so the new
# version is running as soon as the installer finishes. `open` must run inside
# the user's GUI session, or the window would belong to the installer's root
# context and never show up on their desktop.
if as_user open "$APP"; then
	echo "dispatchq: opened $APP for $consoleUser"
else
	echo "dispatchq: could not open DispatchQ automatically; open it from Applications"
fi

exit 0
