#!/bin/sh
# postinstall — set up the per-user LaunchAgent so the claudeq daemon starts at
# login. The installer runs as root, but the LaunchAgent belongs to the logged-in
# user, so we drop into that user's GUI launchd context to install it. The
# bundled daemon's own `install` command writes ~/Library/LaunchAgents and
# bootstraps gui/<uid>, pointing the plist at the daemon inside the app bundle.
set -e

APP="/Applications/ClaudeQ.app"
DAEMON="$APP/Contents/MacOS/claudeqd"

if [ ! -x "$DAEMON" ]; then
	echo "claudeq: daemon not found at $DAEMON; skipping autostart setup"
	exit 0
fi

consoleUser=$(stat -f "%Su" /dev/console 2>/dev/null || echo "")
if [ -z "$consoleUser" ] || [ "$consoleUser" = "root" ]; then
	# Headless / no GUI login window user — the app will set up autostart on its
	# first launch instead. Don't fail the install over it.
	echo "claudeq: no console user; the app will set up autostart on first launch"
	exit 0
fi
uid=$(id -u "$consoleUser")

# Stop any stray daemon (an orphan from a prior version/label still holding the
# loopback port). Otherwise the freshly-installed daemon can't bind and the old
# one keeps serving — so a reinstall would appear to have no effect.
pkill -f 'claudeqd run' 2>/dev/null || true

# `launchctl asuser` enters the user's GUI launchd domain; `sudo -u` adopts the
# user's identity and HOME so the plist lands in their LaunchAgents directory.
if ! launchctl asuser "$uid" sudo -u "$consoleUser" "$DAEMON" install; then
	echo "claudeq: autostart setup failed; open ClaudeQ.app to enable it"
fi

# Allow the daemon to schedule wake-ups (pmset) without a password, so timed
# tasks can wake the Mac from sleep. The console user is detected here (not
# hardcoded); the entry is validated with visudo before install so a bad file
# can never break sudo. The uninstall script removes it.
sudoers="/etc/sudoers.d/claudeq"
tmp="$(mktemp)"
printf '%s ALL=(root) NOPASSWD: /usr/bin/pmset\n' "$consoleUser" > "$tmp"
if visudo -cf "$tmp" >/dev/null 2>&1; then
	install -m 0440 -o root -g wheel "$tmp" "$sudoers"
	echo "claudeq: installed pmset wake permission for $consoleUser"
else
	echo "claudeq: could not install pmset sudoers entry; scheduled wake will need manual setup"
fi
rm -f "$tmp"

# Reopen ClaudeQ for the user (preinstall closed the old window) so the new
# version is running as soon as the installer finishes. Wait for the daemon
# the LaunchAgent just started to answer first: if the window comes up while
# the daemon is still binding, the app starts a second daemon of its own and
# the two fight over the loopback port.
i=0
while ! curl -sf -o /dev/null --max-time 1 http://127.0.0.1:8765/api/tasks && [ "$i" -lt 100 ]; do
	sleep 0.1
	i=$((i + 1))
done
# `open` must run inside the user's GUI session, or the window would belong
# to the installer's root context and never show up on their desktop.
if launchctl asuser "$uid" sudo -u "$consoleUser" open "$APP"; then
	echo "claudeq: opened $APP for $consoleUser"
else
	echo "claudeq: could not open ClaudeQ automatically; open it from Applications"
fi

exit 0
