# Build output
/bin/
/dist/
/build/

# Test / coverage artifacts
*.out
coverage.*

# macOS
.DS_Store


# The web UI is built from web/ into internal/api/web (embedded by the daemon);
# only the placeholder that keeps go:embed happy is tracked.
/internal/api/web/*
!/internal/api/web/.gitkeep
web/node_modules/

# Binaries from a `go build ./cmd/...` at the repository root
/dispatchq
/dispatchqd
/dispatchqapp
